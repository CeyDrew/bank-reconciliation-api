{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Quartz": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "Seed": false
  },
  "FakeBank": {
    "BaseUrl": ""
  },
  "TransactionImport": {
    "InitialLookbackDays": 30,
    "OverlapDays": 2
  },
  "Jwt": {
    "Issuer": "bank-reconciliation-api",
    "Audience": "bank-reconciliation-api",
    "SigningKey": "",
    "LifetimeMinutes": 60
  },
  "SeedUsers": {
    "AdminPassword": "",
    "AccountantPassword": ""
  },
  "Webhooks": {
    "Url": "",
    "Secret": "",
    "DispatchIntervalSeconds": 10,
    "MaxAttempts": 10,
    "BatchSize": 50
  },
  "Reconciliation": {
    "AutoMatchThreshold": 80
  },
  "Jobs": {
    "BankSync": {
      "Enabled": false,
      "IntervalSeconds": 300
    }
  }
}
