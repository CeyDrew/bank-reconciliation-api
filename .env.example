# Copy to .env and set your own values. .env is git-ignored.

# SQL Server SA password: at least 8 chars, with 3 of: upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=

# HMAC key for signing JWTs, at least 32 characters. For example: openssl rand -base64 48
JWT_SIGNING_KEY=

# Initial passwords for admin@example.com and accountant@example.com (at least 12 characters).
# Only used when the user table is empty.
SEED_ADMIN_PASSWORD=
SEED_ACCOUNTANT_PASSWORD=

# Shared HMAC secret for webhooks to the ERP (the fake ERP uses the same value), at least 32 characters.
WEBHOOK_SECRET=
