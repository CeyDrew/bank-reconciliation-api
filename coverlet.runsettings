<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Generated EF Core migrations are not hand-written logic. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <Include>[Reconciliation.*]*</Include>
          <Exclude>[Reconciliation.*Tests]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
